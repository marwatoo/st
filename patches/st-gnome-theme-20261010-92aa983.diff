+++ b/x.c
@@ -5,6 +5,11 @@
 #include <locale.h>
 #include <signal.h>
 #include <sys/select.h>
+#include <sys/wait.h>
+#include <fcntl.h>
+#ifdef __linux__
+#include <sys/prctl.h>
