@@ -0,0 +1,28 @@
+# st-osc133.zsh — OSC 133 prompt markers for st prompt-to-prompt scrolling.
+#
+# Source this from your ~/.zshrc:
+#     [ -f /usr/local/share/st/st-osc133.zsh ] && . /usr/local/share/st/st-osc133.zsh
+# (adjust the path to wherever you keep this file)
+#
+# Once enabled, Alt+PageUp / Alt+PageDown in st jump between shell prompts.
+#
+# What it emits (see https://gitlab.freedesktop.org/Per_Bothner/Specifications):
+#   OSC 133;A   prompt (i.e. the shell) has started
+#   OSC 133;B   the prompt text is being drawn
+#   OSC 133;C   the command line is being edited (skipped here)
+#   OSC 133;D   the command has finished (followed by its exit status)
+
+autoload -Uz add-zsh-hook
+
+__st_prompt_precmd() {
+    # D: previous command finished (carries its exit status)
+    print -n $'\e]133;D;'$?$'\e\\'
+    # A: new prompt starts
+    print -n $'\e]133;A\e\\'
+}
+add-zsh-hook precmd __st_prompt_precmd
+
+# Mark the end of the prompt (prepended to the prompt text, before printing).
+if [[ $PROMPT != *'133;B'* ]]; then
+    PROMPT=$'%{\e]133;B\e\\%}'$PROMPT
+fi
