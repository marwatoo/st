+/*
+ * Cell range covered by the URL under screen cell (x, y).
+ * Returns 1 and fills in the first and last covered cells, or 0.
+ */
+int
+turlcells(int x, int y, int *sx, int *sy, int *ex, int *ey)
+{
+	Rune *buf;
+	char *url;
+	long cidx = -1;
+	size_t n, fi = 0, fj = 0;
+	int y0, y1, r, c, k, found;
+
+	if (y < 0 || y >= term.row || x < 0 || x >= term.col)
+		return 0;
+
+	buf = tgather(y, &y0, &y1, x, &cidx, &n);
+	if (cidx < 0) {
+		free(buf);
+		return 0;
+	}
+	url = urlscan(buf, n, cidx, &fi, &fj);
+	found = url != NULL;
+	free(url);
+	free(buf);
+	if (!found)
+		return 0;
+
+	/* map the flat rune indices back onto screen cells */
+	k = 0;
+	for (r = y0; r <= y1; r++) {
+		for (c = 0; c < term.col; c++) {
+			if (TLINE(r)[c].mode & ATTR_WDUMMY)
+				continue;
+			if (k == (int)fi) {
+				*sx = c;
+				*sy = r;
+			}
+			if (k == (int)fj - 1) {
+				*ex = c;
+				*ey = r;
+				if (TLINE(r)[c].mode & ATTR_WIDE)
+					*ex = c + 1;
+			}
+			k++;
+		}
+	}
+	return 1;
+}
