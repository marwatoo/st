+
+/* the sixel palette registers start out black */
+static void
+sixel_hls_to_rgb(int h, int l, int s, uint32_t *rgb)
+{
+	double H = (h % 360) / 360.0, L = l / 100.0, S = s / 100.0;
+	double C, X, m, R = 0, G = 0, B = 0;
+	int sextant;
+
+	if (S == 0) {
+		*rgb = ((uint32_t)(L * 255) << 16) | ((uint32_t)(L * 255) << 8) |
+		       (uint32_t)(L * 255);
+		return;
+	}
+	C = (1 - fabs(2 * L - 1)) * S;
+	X = C * (1 - fabs(fmod(H * 6, 2) - 1));
+	m = L - C / 2;
+	sextant = (int)(H * 6) % 6;
+	switch (sextant) {
+	case 0: R = C; G = X; B = 0; break;
+	case 1: R = X; G = C; B = 0; break;
+	case 2: R = 0; G = C; B = X; break;
+	case 3: R = 0; G = X; B = C; break;
+	case 4: R = X; G = 0; B = C; break;
+	case 5: R = C; G = 0; B = X; break;
+	}
+	*rgb = ((uint32_t)((R + m) * 255) << 16) |
+	       ((uint32_t)((G + m) * 255) << 8) |
+	       (uint32_t)((B + m) * 255);
+}
+
+static int
+sixel_readnum(const char **pp, const char *end)
+{
+	const char *p = *pp;
+	int v = 0;
+
+	while (p < end && *p >= '0' && *p <= '9') {
+		v = v * 10 + (*p - '0');
+		if (v > 1000000)
+			v = 1000000;
+		p++;
+	}
+	*pp = p;
+	return v;
+}
+
+static void
+sixel_parse(const char *data, size_t len, int cx, int cy)
+{
+	const char *p, *end;
+	int x, y, maxx, maxy, repeat, bit, r, rows, i, pc, pu, px, py, pz;
+	uint32_t pal[256], *pix;
+	SixelImage *im;
+	SixelImage **pp, *tail;
+
+	if (len == 0)
+		return;
+	end = data + len;
+
+	/* DCS parameters (digits and ';') up to the 'q' that starts the data */
+	p = data;
+	while (p < end && ((*p >= '0' && *p <= '9') || *p == ';' || *p == ' '))
+		p++;
+	if (p >= end || *p != 'q')
+		return;
+	p++;
+
+	/* pass 1: find the image extents */
+	x = y = maxx = maxy = 0;
+	repeat = 1;
+	{
+		const char *t = p;
+		while (t < end) {
+			unsigned char c = *t++;
+			if (c == '"') { /* raster attributes "Pan;Pad;Ph;Pv" */
+				int w, h;
+				sixel_readnum(&t, end);
+				if (t < end && *t == ';') t++;
+				sixel_readnum(&t, end);
+				if (t < end && *t == ';') t++;
+				w = sixel_readnum(&t, end);
+				if (t < end && *t == ';') t++;
+				h = sixel_readnum(&t, end);
+				if (w > maxx) maxx = w;
+				if (h > maxy) maxy = h;
+			} else if (c == '#') {
+				sixel_readnum(&t, end);
+				while (t < end && *t == ';') {
+					t++;
+					sixel_readnum(&t, end);
+				}
+			} else if (c == '!') {
+				repeat = sixel_readnum(&t, end);
+				if (repeat < 1)
+					repeat = 1;
+			} else if (c == '$') {
+				x = 0;
+			} else if (c == '-') {
+				x = 0;
+				y += 6;
+				if (y > maxy) maxy = y;
+			} else if (c >= '?' && c <= '~') {
+				x += repeat;
+				if (x > maxx) maxx = x;
+				if (y + 6 > maxy) maxy = y + 6;
+				repeat = 1;
+			}
+		}
+	}
+	if (maxx <= 0 || maxy <= 0)
+		return;
+	if ((long)maxx * maxy > SIXEL_MAX_PIXELS)
+		return;
+
+	/* pass 2: rasterize */
+	pix = xmalloc((size_t)maxx * maxy * sizeof(uint32_t));
+	for (i = 0; i < maxx * maxy; i++)
+		pix[i] = SIXEL_UNSET;
+	for (i = 0; i < 256; i++)
+		pal[i] = 0;
+
+	x = y = 0;
+	repeat = 1;
+	pc = 0;
+	while (p < end) {
+		unsigned char c = *p++;
+		if (c == '"') {
+			sixel_readnum(&p, end);
+			if (p < end && *p == ';') p++;
+			sixel_readnum(&p, end);
+			if (p < end && *p == ';') p++;
+			sixel_readnum(&p, end);
+			if (p < end && *p == ';') p++;
+			sixel_readnum(&p, end);
+		} else if (c == '#') {
+			pc = sixel_readnum(&p, end);
+			if (pc > 255)
+				pc = 0;
+			if (p < end && *p == ';') {
+				p++;
+				pu = sixel_readnum(&p, end);
+				if (p < end && *p == ';') p++;
+				px = sixel_readnum(&p, end);
+				if (p < end && *p == ';') p++;
+				py = sixel_readnum(&p, end);
+				if (p < end && *p == ';') p++;
+				pz = sixel_readnum(&p, end);
+				if (pu == 2) { /* RGB, 0..100 */
+					int mx = MAX(px, MAX(py, pz));
+					if (mx > 100) { /* some encoders use 0..255 */
+						pal[pc] = ((uint32_t)(px & 0xff) << 16) |
+						          ((uint32_t)(py & 0xff) << 8) |
+						          (uint32_t)(pz & 0xff);
+					} else {
+						pal[pc] = ((uint32_t)(px * 255 / 100) << 16) |
+						          ((uint32_t)(py * 255 / 100) << 8) |
+						          (uint32_t)(pz * 255 / 100);
+					}
+				} else if (pu == 1) { /* HLS */
+					sixel_hls_to_rgb(px, py, pz, &pal[pc]);
+				}
+			}
+		} else if (c == '!') {
+			repeat = sixel_readnum(&p, end);
+			if (repeat < 1)
+				repeat = 1;
+		} else if (c == '$') {
+			x = 0;
+		} else if (c == '-') {
+			x = 0;
+			y += 6;
+		} else if (c >= '?' && c <= '~') {
+			int bits = c - '?';
+			for (r = 0; r < repeat && x < maxx; r++, x++) {
+				for (bit = 0; bit < 6; bit++) {
+					if (bits & (1 << bit)) {
+						int yy = y + bit;
+						if (yy < maxy)
+							pix[(size_t)yy * maxx + x] = pal[pc];
+					}
+				}
+			}
+			repeat = 1;
+		}
+		/* everything else is ignored */
+	}
+
+	im = xmalloc(sizeof(*im));
+	im->absline = tabsline() + cy;
+	im->col = cx;
+	im->w = maxx;
+	im->h = maxy;
+	im->pix = pix;
+	im->next = sixel_images;
+	sixel_images = im;
+	sixel_tainted = 1;
+
+	/* push the cursor below the image, scrolling if necessary */
+	rows = (maxy + win.ch - 1) / win.ch;
+	tsixeladvance(rows);
+
+	/* keep the list bounded: drop the oldest (tail) images */
+	for (i = 0, tail = NULL, pp = &sixel_images; *pp; pp = &(*pp)->next) {
+		tail = *pp;
+		if (++i > SIXEL_MAX_IMAGES)
+			break;
+	}
+	if (i > SIXEL_MAX_IMAGES && tail) {
+		for (pp = &sixel_images; (*pp)->next != tail; pp = &(*pp)->next)
+			;
+		*pp = NULL;
+		while (tail) {
+			SixelImage *nx = tail->next;
+			free(tail->pix);
+			free(tail);
+			tail = nx;
+		}
+	}
+}
+
+void
+xinlinesixel(const char *buf, size_t len, int cx, int cy)
+{
+	sixel_parse(buf, len, cx, cy);
+}
+
+/* fill an XImage rectangle from the RGB buffer, clipping via sx/sy */
+static void
+xblitsixel(int dx, int dy, int sx, int sy, int w, int h, int stride,
+           const uint32_t *pix)
+{
+	XImage *img;
+	XColor xc;
+	int x, y;
+	static unsigned long bgpixel;
+
+	if (w <= 0 || h <= 0)
+		return;
+	img = XCreateImage(xw.dpy, xw.vis, DefaultDepth(xw.dpy, xw.scr),
+		ZPixmap, 0, NULL, (unsigned int)w, (unsigned int)h, 32, 0);
+	if (!img)
+		return;
+	img->data = xmalloc((size_t)img->bytes_per_line * h);
+	memset(img->data, 0, (size_t)img->bytes_per_line * h);
+	bgpixel = dc.col[defaultbg].pixel;
+
+	for (y = 0; y < h; y++) {
+		for (x = 0; x < w; x++) {
+			uint32_t rgb = pix[(size_t)(sy + y) * stride + (sx + x)];
+			unsigned long pv;
+			int i, found = 0;
+			if (rgb == SIXEL_UNSET) {
+				pv = bgpixel;
+			} else {
+				for (i = 0; i < sixel_pixcachelen; i++) {
+					if (sixel_pixcache[i].rgb == rgb) {
+						pv = sixel_pixcache[i].pixel;
+						found = 1;
+						break;
+					}
+				}
+				if (!found) {
+					if (sixel_pixcachelen >= sixel_pixcachecap) {
+						sixel_pixcachecap = sixel_pixcachecap ?
+							sixel_pixcachecap * 2 : 1024;
+						sixel_pixcache = xrealloc(sixel_pixcache,
+							sixel_pixcachecap * sizeof(*sixel_pixcache));
+					}
+					xc.red = ((rgb >> 16) & 0xff) * 0x101;
+					xc.green = ((rgb >> 8) & 0xff) * 0x101;
+					xc.blue = (rgb & 0xff) * 0x101;
+					xc.flags = DoRed | DoGreen | DoBlue;
+					if (XAllocColor(xw.dpy, xw.cmap, &xc)) {
+						pv = xc.pixel;
+						sixel_pixcache[sixel_pixcachelen].rgb = rgb;
+						sixel_pixcache[sixel_pixcachelen].pixel = pv;
+						sixel_pixcachelen++;
+					} else {
+						pv = bgpixel;
+					}
+				}
+			}
+			XPutPixel(img, x, y, pv);
+		}
+	}
+	XPutImage(xw.dpy, xw.buf, dc.gc, img, 0, 0, dx, dy, w, h);
+	free(img->data);
+	img->data = NULL;
+	XDestroyImage(img);
+}
+
+/* draw all images that intersect the visible area */
+void
+xdrawsixel(void)
+{
+	SixelImage *im;
+	long top;
+	int srow, sy, dy, h, dx, sx, w;
+
+	if (!sixel_tainted)
+		return;
+	sixel_tainted = 0;
+	sixel_pixcachelen = 0;
+	top = tabsline();
+
+	for (im = sixel_images; im; im = im->next) {
+		srow = (int)(im->absline - top);
+		dy = borderpx + srow * win.ch;
+		sy = 0;
+		if (dy < borderpx) {
+			sy = borderpx - dy;
+			dy = borderpx;
+		}
+		h = im->h - sy;
+		if (dy + h > borderpx + win.th)
+			h = borderpx + win.th - dy;
+		if (h <= 0)
+			continue;
+
+		dx = borderpx + im->col * win.cw;
+		sx = 0;
+		w = im->w;
+		if (dx < borderpx) {
+			sx = borderpx - dx;
+			dx = borderpx;
+			w -= sx;
+		}
+		if (dx + w > borderpx + win.tw)
+			w = borderpx + win.tw - dx;
+		if (w <= 0)
+			continue;
+
+		xblitsixel(dx, dy, sx, sy, w, h, im->w, im->pix);
+	}
+}
