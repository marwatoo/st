+/* dir < 0: closest mark above `top`; dir > 0: closest mark below the screen */
+static int
+promptfind(int dir, long top, long *out)
+{
+	int i, found = 0;
+
+	for (i = 0; i < promptmark_n; i++) {
+		long a = promptmark[i];
+		if (dir < 0) {
+			if (a < top && (!found || a > *out)) {
+				*out = a;
+				found = 1;
+			}
+		} else {
+			if (a > top + term.row - 1 && (!found || a < *out)) {
+				*out = a;
+				found = 1;
+			}
+		}
+	}
+	return found;
+}
