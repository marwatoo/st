+void
+promptup(const Arg *arg)
+{
+	long a, old = term.scr, scr;
+
+	(void)arg;
+	if (!promptfind(-1, tabsline(), &a))
+		return;
+	scr = (long)term.histabs - a;
+	LIMIT(scr, 0, HISTSIZE - 1);
+	if (scr == term.scr)
+		return;
+	term.scr = (int)scr;
+	selscroll(0, (int)(scr - old));
+	tfulldirt();
+}
