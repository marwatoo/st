@@ -0,0 +1,33 @@
+# st-osc133.bash — OSC 133 prompt markers for st prompt-to-prompt scrolling.
+#
+# Source this from your ~/.bashrc:
+#     [ -f /usr/local/share/st/st-osc133.bash ] && . /usr/local/share/st/st-osc133.bash
+# (adjust the path to wherever you keep this file)
+#
+# Once enabled, Alt+PageUp / Alt+PageDown in st jump between shell prompts.
+#
+# What it emits (see https://gitlab.freedesktop.org/Per_Bothner/Specifications):
+#   OSC 133;A   prompt (i.e. the shell) has started
+#   OSC 133;B   the prompt text is being drawn
+#   OSC 133;C   the command line is being edited (skipped here)
+#   OSC 133;D   the command has finished (followed by its exit status)
+
+__st_prompt_command() {
+    local __ret=$?
+    printf '\033]133;D;%s\033\\' "$__ret"
+    printf '\033]133;A\033\\'
+    return $__ret
+}
+
+if [ -n "${PROMPT_COMMAND}" ]; then
+    PROMPT_COMMAND="__st_prompt_command; ${PROMPT_COMMAND}"
+else
+    PROMPT_COMMAND="__st_prompt_command"
+fi
+
+# Mark the end of the prompt so the text between A and B is one unit.
+# Only prepend the marker once, and only if it is not already there.
+case "$PS1" in
+    *'133;B'*) ;;
+    *) PS1='\[\033]133;B\033\\\]'"$PS1" ;;
+esac
--- /dev/null
